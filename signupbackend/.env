# إعدادات الخادم
PORT=5000
NODE_ENV=development

# قاعدة البيانات
MONGODB_URI=mongodb://localhost:27017/auth_database
# أو لـ PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/auth_database

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# الأمان
BCRYPT_SALT_ROUNDS=10